# Copy this file to .env and adjust. Defaults below are for a local Ollama server (free).

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# json_schema = strict format enforcement (best). Use json_object if a provider rejects it.
LLM_SCHEMA_MODE=json_schema
LLM_TEMPERATURE=0

# Smaller model for computers with less memory:
# LLM_MODEL=llama3.2:3b

# Phase 4: model that turns text into vectors for KB search (run: ollama pull nomic-embed-text)
LLM_EMBED_MODEL=nomic-embed-text
# Model that grades drafted replies during evaluation (defaults to LLM_MODEL)
# LLM_JUDGE_MODEL=qwen2.5:7b
# Model that writes the draft replies (defaults to LLM_MODEL). Lets a small model classify
# while a bigger one writes, e.g. LLM_MODEL=llama3.2:3b with LLM_REPLY_MODEL=qwen2.5:7b
# LLM_REPLY_MODEL=qwen2.5:7b
